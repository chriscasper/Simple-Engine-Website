<!DOCTYPE html>
<html lang="{{ site.language or 'en' }}">
<head>
  {% include "partials/head.njk" %}
</head>
<body class="min-h-screen bg-stone-50 text-stone-900 antialiased">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-3 focus:py-2 focus:shadow">
    Skip to content
  </a>

  <header class="sticky top-0 z-40 border-b border-stone-200/80 bg-stone-50/90 backdrop-blur-md">
    <nav class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-4 py-4 sm:px-6" aria-label="Primary">
      <a href="/" class="inline-flex items-center" aria-label="Simple Engine home">
        <img src="/logo.svg" alt="Simple Engine" width="206" height="50" class="h-8 w-auto sm:h-9" />
      </a>
      <div class="flex items-center gap-5 text-sm font-medium text-stone-600 sm:gap-7">
        <a href="/docs" class="transition hover:text-brand">Docs</a>
        <a href="/blog" class="transition hover:text-brand">Blog</a>
        <a
          href="https://github.com/chriscasper/Simple-Engine"
          class="transition hover:text-brand"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Simple Engine on GitHub"
        >GitHub</a>
        <a href="/docs/getting-started" class="btn btn-sm hidden sm:inline-flex">Get started</a>
      </div>
    </nav>
  </header>

  <main id="main">
    {% block content %}{% endblock %}
  </main>

  <footer class="border-t border-stone-200 bg-white">
    <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <div>
        <a href="/" class="inline-flex items-center" aria-label="Simple Engine home">
          <img src="/logo.svg" alt="Simple Engine" width="206" height="50" class="h-7 w-auto" />
        </a>
        <p class="mt-2 text-sm text-stone-500">A seriously simple static site generator.</p>
      </div>
      <div class="flex flex-wrap items-center gap-5 text-sm text-stone-600">
        <a href="/docs" class="hover:text-brand">Docs</a>
        <a href="/blog" class="hover:text-brand">Blog</a>
        <a href="/feed.xml" class="hover:text-brand">RSS</a>
        <div class="flex items-center gap-4">
          <a
            href="https://www.npmjs.com/package/simple-engine"
            class="inline-flex items-center text-stone-500 transition hover:text-brand"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="simple-engine on npm"
          >
            <svg class="h-5 w-5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M0 0v16h16V0H0zm13 13h-2V5H8v8H3V3h10v10z" clip-rule="evenodd"/>
            </svg>
          </a>
          <a
            href="https://github.com/chriscasper/Simple-Engine-Website"
            class="inline-flex items-center text-stone-500 transition hover:text-brand"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Simple Engine Website on GitHub"
          >
            <svg class="h-5 w-5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
    <div class="border-t border-stone-100">
      <p class="mx-auto max-w-6xl px-4 py-4 text-center text-xs text-stone-400 sm:px-6 sm:text-left">
        &copy; {{ 'now' | date('yyyy') }} {{ site.author or site.title }} · MIT License ·
        <a href="https://simpleengine.com" class="hover:text-brand">Built with Simple Engine</a>
      </p>
    </div>
  </footer>
</body>
</html>
