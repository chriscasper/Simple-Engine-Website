{% extends "base.njk" %}

{% block content %}
<section class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
  <header class="mb-10">
    <h1 class="font-display text-4xl font-bold tracking-tight text-stone-900">{{ title }}</h1>
    {% if description %}
    <p class="mt-3 text-lg text-stone-600">{{ description }}</p>
    {% endif %}
  </header>

  {% if content %}
  <div class="prose prose-stone prose-lg mb-12 max-w-none prose-headings:font-display prose-a:text-brand">
    {{ content | safe }}
  </div>
  {% endif %}

  <div class="space-y-8">
    {% for post in collections.posts %}
    <article class="border-b border-stone-200 pb-8">
      <h2 class="font-display text-2xl font-semibold tracking-tight">
        <a href="{{ post.url }}" class="text-stone-900 transition hover:text-brand">{{ post.data.title }}</a>
      </h2>
      {% if post.data.date %}
      <time class="mt-2 block text-sm text-stone-500" datetime="{{ post.data.date }}">
        {{ post.data.date | date('MMMM d, yyyy') }}
      </time>
      {% endif %}
      {% if post.data.description %}
      <p class="mt-3 text-stone-600">{{ post.data.description }}</p>
      {% endif %}
    </article>
    {% else %}
    <p class="text-stone-600">No posts yet.</p>
    {% endfor %}
  </div>
</section>
{% endblock %}
