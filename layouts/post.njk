{% extends "base.njk" %}

{% block content %}
<article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
  <header class="mb-10">
    <nav class="text-sm text-stone-500" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li>
          <a href="/blog" class="font-medium text-brand transition hover:opacity-80">Blog</a>
        </li>
        <li aria-hidden="true" class="text-stone-300">/</li>
        <li class="truncate text-stone-500" aria-current="page">{{ title }}</li>
      </ol>
    </nav>
    <h1 class="mt-4 font-display text-4xl font-bold tracking-tight text-stone-900">{{ title }}</h1>
    {% if date %}
    <time class="mt-3 block text-sm text-stone-500" datetime="{{ date }}">
      {{ date | date('MMMM d, yyyy') }}
    </time>
    {% endif %}
    {% if description %}
    <p class="mt-4 text-lg text-stone-600">{{ description }}</p>
    {% endif %}
  </header>

  <div class="prose prose-stone prose-lg max-w-none prose-headings:font-display prose-a:text-brand prose-code:before:content-none prose-code:after:content-none">
    {{ content | safe }}
  </div>

  {% if tags %}
  <div class="mt-10 flex flex-wrap gap-2">
    {% for tag in tags %}
    <span class="rounded-md bg-stone-100 px-2.5 py-1 text-xs font-medium text-stone-600">{{ tag }}</span>
    {% endfor %}
  </div>
  {% endif %}

  <footer class="mt-10 flex justify-end border-t border-stone-200 pt-8">
    <a href="/blog" class="btn btn-sm" aria-label="Back to blog">Back To Blog</a>
  </footer>
</article>
{% endblock %}
