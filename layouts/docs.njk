{% extends "base.njk" %}

{% set docsPages = collections.docs %}

{% block content %}
<div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
  <div class="lg:grid lg:grid-cols-[240px_minmax(0,1fr)] lg:gap-12">
    <aside class="mb-10 lg:mb-0">
      <nav class="lg:sticky lg:top-24" aria-label="Documentation">
        <p class="font-display text-xs font-semibold uppercase tracking-[0.15em] text-stone-400">
          Documentation
        </p>
        <ul class="mt-4 space-y-1">
          {% for doc in docsPages %}
          <li>
            <a
              href="{{ doc.url }}"
              class="docs-nav-link{% if doc.url == page.url %} is-active{% endif %}"
              {% if doc.url == page.url %}aria-current="page"{% endif %}
            >
              {{ doc.data.title }}
            </a>
          </li>
          {% endfor %}
        </ul>
      </nav>
    </aside>

    <div>
      <article class="prose prose-stone prose-lg max-w-none prose-headings:font-display prose-a:text-brand prose-code:before:content-none prose-code:after:content-none">
        <header class="not-prose mb-8">
          <h1 class="font-display text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl">{{ title }}</h1>
          {% if description %}
          <p class="mt-3 text-lg text-stone-600">{{ description }}</p>
          {% endif %}
        </header>
        {{ content | safe }}
      </article>

      <nav class="mt-14 flex flex-col gap-4 border-t border-stone-200 pt-8 sm:flex-row sm:justify-between" aria-label="Docs pagination">
        {% for doc in docsPages %}
          {% if doc.url == page.url %}
            {% if loop.index0 > 0 %}
            <a href="{{ docsPages[loop.index0 - 1].url }}" class="group rounded-lg border border-stone-200 bg-white px-4 py-3 transition hover:border-brand/40">
              <span class="block text-xs font-medium uppercase tracking-wide text-stone-400">Previous</span>
              <span class="mt-1 block font-medium text-stone-900 group-hover:text-brand">{{ docsPages[loop.index0 - 1].data.title }}</span>
            </a>
            {% else %}
            <span class="hidden sm:block"></span>
            {% endif %}
            {% if not loop.last %}
            <a href="{{ docsPages[loop.index0 + 1].url }}" class="group rounded-lg border border-stone-200 bg-white px-4 py-3 text-left transition hover:border-brand/40 sm:ml-auto sm:text-right">
              <span class="block text-xs font-medium uppercase tracking-wide text-stone-400">Next</span>
              <span class="mt-1 block font-medium text-stone-900 group-hover:text-brand">{{ docsPages[loop.index0 + 1].data.title }}</span>
            </a>
            {% endif %}
          {% endif %}
        {% endfor %}
      </nav>
    </div>
  </div>
</div>
{% endblock %}
